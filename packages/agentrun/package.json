{
  "name": "@open-instinct/agentrun",
  "version": "0.1.0",
  "description": "AgentRun workflow integration for Open Instinct: adapters, recovery, and the agentrun tool",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.4 <1.4.0",
    "@earendil-works/pi-ai": ">=1.0.4 <1.4.0",
    "@open-instinct/core": "workspace:*",
    "@parcha/agentrun-dsl": "0.1.0-beta.21",
    "@parcha/agentrun-jev": "0.1.0-beta.21",
    "@parcha/agentrun-pi": "0.1.0-beta.21",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.4 <1.4.0",
    "@earendil-works/pi-tui": ">=1.0.4 <1.4.0",
    "@earendil-works/pi-durable": ">=1.0.4 <1.4.0",
    "@earendil-works/chord": ">=1.0.4 <1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
