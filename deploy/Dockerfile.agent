# Open Instinct agent image: the per-user agent process (Maritime BYO contract).
# Serves /health, /chat, /schedules, /webhooks/inkbox.
ARG CACHEBUST=1
FROM node:22-slim AS base
ARG CACHEBUST=1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN echo "cachebust=$CACHEBUST" && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
# pnpm applies patchedDependencies during install, so the patch files must be present first.
COPY patches ./patches
COPY packages/core/package.json packages/core/
COPY packages/inkbox/package.json packages/inkbox/
COPY packages/computer/package.json packages/computer/
COPY packages/context/package.json packages/context/
COPY packages/apps/package.json packages/apps/
COPY packages/network/package.json packages/network/
COPY packages/payments/package.json packages/payments/
COPY packages/ample/package.json packages/ample/
COPY packages/atomicmail/package.json packages/atomicmail/
COPY packages/agentrun/package.json packages/agentrun/
COPY packages/server/package.json packages/server/
COPY packages/gateway/package.json packages/gateway/
COPY packages/cli/package.json packages/cli/
COPY packages/postiz-mcp/package.json packages/postiz-mcp/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages ./packages
# Playbooks (sop-architect, pipeline-guide, deep-research, ...) are loaded at boot from /app/skills.
COPY skills ./skills
RUN pnpm --filter @open-instinct/core build \
  && pnpm -r --filter './packages/*' run build \
  && (pnpm prune --prod || echo "prune skipped; keeping dev deps")

FROM base AS runtime
ENV NODE_ENV=production \
    PORT=8080 \
    INSTINCT_SKILLS_DIR=/app/skills \
    INSTINCT_AGENTRUN=1
COPY --from=build /app /app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1
CMD ["node", "packages/server/dist/main.js"]