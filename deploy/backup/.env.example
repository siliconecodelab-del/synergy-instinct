# =============================================================================
# Coolify Backup Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# OCI Object Storage (S3-compatible)
# ---------------------------------------------------------------------------
# Get these from OCI Console:
#   1. Storage > Object Storage > Buckets -> create bucket
#   2. Profile icon -> My Profile -> Customer Secret Keys -> Generate key
#
# Endpoint format:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Example:
#   https://axyz12345678.compat.objectstorage.af-johannesburg-1.oraclecloud.com
OCI_OBJECT_STORAGE_ENDPOINT=https://<your-namespace>.compat.objectstorage.af-johannesburg-1.oraclecloud.com

# Bucket name for Coolify backups
OCI_OBJECT_STORAGE_BUCKET=coolify-backups

# OCI Customer Secret Key (from OCI Console -> Profile -> Customer Secret Keys)
OCI_ACCESS_KEY=ocid1.tenancy.oc1..aaaaaaa...
OCI_SECRET_KEY=Jz...secret...

# ---------------------------------------------------------------------------
# Coolify Configuration
# ---------------------------------------------------------------------------
# Path to Coolify data directory on the host
COOLIFY_DATA_DIR=/data/coolify

# Number of days to keep local backup files before cleanup
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Optional: Docker registry credentials (for private images)
# ---------------------------------------------------------------------------
# DOCKER_REGISTRY_USER=
# DOCKER_REGISTRY_PASS=